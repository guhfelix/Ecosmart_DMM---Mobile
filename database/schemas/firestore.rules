rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function para verificar se o usuário autenticado é o dono do documento/recurso
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Coleção de Usuários: Apenas o próprio usuário autenticado pode ler ou editar seu perfil
    match /usuarios/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Coleção de Descartes:
    // Leitura: O usuário pode ler apenas documentos onde userId (ou citizenId/usuario_id) for igual ao seu UID
    // Criação: O novo documento deve pertencer ao usuário logado (userId == request.auth.uid)
    // Atualização e Exclusão: Apenas o proprietário do descarte pode modificar ou apagar
    match /descartes/{discardId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        resource.data.usuario_id == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.citizenId == request.auth.uid ||
        request.resource.data.usuario_id == request.auth.uid
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.citizenId == request.auth.uid ||
        resource.data.usuario_id == request.auth.uid
      );
    }

    // Coleções públicas de consulta (somente leitura para usuários autenticados)
    match /tipos_residuos/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.perfil == 'admin';
    }

    match /pontos_coleta/{pointId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.perfil == 'admin';
    }

    match /dicas_educativas/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.token.perfil == 'admin';
    }

    // Notificações: Restrito ao destinatário
    match /notificacoes/{notificationId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid
      );
    }

    // Bloqueio padrão para todas as outras coleções
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


