rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário autenticado é Administrador
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.perfil == 'admin' ||
        request.auth.token.email == 'admin.caceres@ecosmart.com' ||
        request.auth.token.email == 'joao@gmail.com'
      );
    }

    // Função auxiliar para verificar se o usuário autenticado é o proprietário do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. ÁREA EXCLUSIVA DE ADMINISTRAÇÃO (Coleções raiz 'admins' e 'admin_logs')
    // 100% inacessível para Cidadão e Coletor.
    // Apenas Administradores possuem permissão de leitura e escrita.
    // =========================================================================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 2. COLEÇÃO DE USUÁRIOS COMUNS (/usuarios)
    // Cidadão/Coletor: Leitura e escrita operacionais.
    // Blindagem estrita: Proibida a injeção de contas administrativas em /usuarios.
    // Administrador: ACESSO TOTAL de leitura e escrita para gerenciar os usuários.
    // =========================================================================
    match /usuarios/{userId} {
      allow read: if true;
      allow create, update: if (request.resource.data.perfil != 'admin') || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 3. COLEÇÃO DE DESCARTES (/descartes)
    // Comunicação operacional em tempo real entre Cidadão e Coletor:
    // Cidadão: Cadastra novos descartes e visualiza seus itens.
    // Coletor: Consulta instantaneamente descartes disponíveis e dá baixa na coleta.
    // Administrador: Acesso completo para auditoria e governança ESG.
    // =========================================================================
    match /descartes/{discardId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // =========================================================================
    // 4. CATÁLOGOS E CONTEÚDOS GERAIS (/tipos_residuos, /pontos_coleta, /dicas_educativas)
    // Leitura operacional livre para consulta pública dos cidadãos e coletores.
    // Escrita restrita exclusivamente a administradores.
    // =========================================================================
    match /tipos_residuos/{typeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pontos_coleta/{pointId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /dicas_educativas/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Notificações em tempo real
    match /notificacoes/{notificationId} {
      allow read, write: if true;
    }

    // Bloqueio padrão para qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
