rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se o usuário está autenticado (A4-10)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para verificar se o usuário autenticado é Administrador via Custom Claims ou coleção isolada
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.perfil == 'admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Função auxiliar para verificar se o usuário autenticado é Coletor autorizado
    function isCollector() {
      return isAuthenticated() && (
        request.auth.token.role == 'coletor' ||
        request.auth.token.perfil == 'coletor' ||
        (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == 'coletor')
      );
    }

    // Função auxiliar para verificar se o usuário autenticado é o proprietário do documento
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Função auxiliar para validar se os dados de usuário não contêm credenciais em texto puro (A4-11)
    function hasNoPlainPassword(data) {
      return !('password' in data) && !('passwordHash' in data);
    }

    // =========================================================================
    // 1. ÁREA EXCLUSIVA DE ADMINISTRAÇÃO (Coleções raiz 'admins' e 'admin_logs')
    // 100% inacessível para Cidadão e Coletor.
    // Apenas Administradores possuem permissão de leitura e escrita.
    // =========================================================================
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 2. COLEÇÃO DE USUÁRIOS COMUNS (/usuarios)
    // Exige autenticação (request.auth != null).
    // Cidadão/Coletor: Apenas o próprio titular pode criar/atualizar seu perfil,
    // sem injeção de perfil 'admin' e sem persistir senha em texto puro.
    // =========================================================================
    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isCollector() || isAdmin();
      allow create, update: if (
        isOwner(userId) &&
        request.resource.data.perfil != 'admin' &&
        hasNoPlainPassword(request.resource.data)
      ) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // =========================================================================
    // 3. COLEÇÃO DE DESCARTES (/descartes)
    // Blindagem RBAC (A4-10):
    // - Cidadão: Lê, cria, edita e exclui exclusivamente seus próprios descartes
    //   (resource.data.userId == request.auth.uid).
    // - Coletor: Lê descartes disponíveis e atualiza apenas os campos de status/coleta
    //   de descartes autorizados, sem alterar proprietário ou dados originais.
    // - Administrador: Acesso completo via Custom Claims / coleção isolada.
    // =========================================================================
    match /descartes/{discardId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCollector() ||
        isAdmin()
      );

      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow update: if isAuthenticated() && (
        // Cidadão proprietário editando seu próprio descarte pendente
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid
        ) ||
        // Coletor atualizando exclusivamente o status/baixa de coleta de descartes autorizados
        (
          isCollector() &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'collectedAt',
            'coletorId',
            'updatedAt',
            'offlineSyncPending',
            'syncPending'
          ])
        ) ||
        // Administrador com privilégios de governança
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // =========================================================================
    // 4. CATÁLOGOS E CONTEÚDOS GERAIS (/tipos_residuos, /pontos_coleta, /dicas_educativas)
    // Leitura operacional para usuários autenticados.
    // Escrita restrita exclusivamente a administradores.
    // =========================================================================
    match /tipos_residuos/{typeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /pontos_coleta/{pointId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /dicas_educativas/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 5. NOTIFICAÇÕES (/notificacoes)
    // Leitura e mutação restritas ao destinatário autenticado ou administrador.
    // =========================================================================
    match /notificacoes/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        isCollector() ||
        isAdmin()
      );
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Bloqueio padrão para qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
